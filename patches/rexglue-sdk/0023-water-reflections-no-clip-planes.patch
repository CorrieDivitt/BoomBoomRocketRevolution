diff --git a/src/graphics/d3d12/command_processor.cpp b/src/graphics/d3d12/command_processor.cpp
--- a/src/graphics/d3d12/command_processor.cpp
+++ b/src/graphics/d3d12/command_processor.cpp
@@ -3100,8 +3100,40 @@
           }
         }
         std::memcpy(constants, r, sizeof(saved));
+        // Patch 0023: user clip planes off for the copy. The copy lies below the water, and a clip
+        // plane left on from the mirror pass (which cuts away everything below the water) would cut
+        // it away too, depending on the camera angle. Logged whenever the burst draw's setting
+        // changes, with the planes.
+        uint32_t& clip_cntl = (*register_file_)[XE_GPU_REG_PA_CL_CLIP_CNTL];
+        const uint32_t saved_clip_cntl = clip_cntl;
+        {
+          static uint32_t logged_clip_cntl = ~uint32_t(0);
+          if (saved_clip_cntl != logged_clip_cntl) {
+            logged_clip_cntl = saved_clip_cntl;
+            reg::PA_CL_CLIP_CNTL c;
+            c.value = saved_clip_cntl;
+            std::string planes;
+            for (uint32_t k = 0; k < 6; ++k) {
+              if (!(c.ucp_ena & (1u << k))) continue;
+              float plane[4];
+              std::memcpy(plane, &(*register_file_)[XE_GPU_REG_PA_CL_UCP_0_X + k * 4], sizeof(plane));
+              planes += fmt::format(" plane {}: ({:.4f} {:.4f} {:.4f} {:.4f})", k, plane[0], plane[1], plane[2],
+                                    plane[3]);
+            }
+            REXLOG_INFO("[bbrr] water reflections: burst draw PA_CL_CLIP_CNTL {:08X} (clip disable {}, user clip "
+                        "planes {:02X}){}",
+                        saved_clip_cntl, uint32_t(c.clip_disable), uint32_t(c.ucp_ena), planes);
+          }
+        }
+        {
+          reg::PA_CL_CLIP_CNTL c;
+          c.value = saved_clip_cntl;
+          c.ucp_ena = 0;
+          clip_cntl = c.value;
+        }
         cbuffer_binding_float_vertex_.up_to_date = false;
         bbrr_ok = IssueDraw(primitive_type, index_count, index_buffer_info, major_mode_explicit);
+        clip_cntl = saved_clip_cntl;
         std::memcpy(constants, saved, sizeof(saved));
         cbuffer_binding_float_vertex_.up_to_date = false;
       }
