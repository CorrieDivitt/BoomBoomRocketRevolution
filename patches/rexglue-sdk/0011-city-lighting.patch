+            index_buffer_info && index_buffer_info->format == xenos::IndexFormat::kInt32,
+            index_buffer_info ? index_buffer_info->endianness : xenos::Endian::kNone, index_count);
+        if (bbrr_box.valid && BbrrLightCityDraw(*register_file_, bbrr_box, bbrr_strength, bbrr_city_light)) {
+          bbrr_city_light.up_to_date = &cbuffer_binding_float_pixel_.up_to_date;
+          cbuffer_binding_float_pixel_.up_to_date = false;
