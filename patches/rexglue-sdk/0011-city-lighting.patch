+    if (bbrr_strength > 0.0f && pixel_shader && bbrr_lights_frame == bbrr_frame) {
+      const uint64_t bbrr_ps_hash = pixel_shader->ucode_data_hash();
+      bool bbrr_city = false;
+      for (uint64_t hash : kBbrrCityPixelShaders) bbrr_city = bbrr_city || hash == bbrr_ps_hash;
+      if (bbrr_city) {
+        const BbrrBox& bbrr_box = BbrrDrawBox(
