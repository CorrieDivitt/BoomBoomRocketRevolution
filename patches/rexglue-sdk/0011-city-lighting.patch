+  BbrrConstantGuard bbrr_city_light;
+  {
+    const uint64_t bbrr_vs_hash = vertex_shader->ucode_data_hash();
+    if (bbrr_vs_hash == kBbrrSmokeVertexShader) BbrrNoteLights(regs);
