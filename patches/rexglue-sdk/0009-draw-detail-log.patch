+// Boom Boom Rocket Revolution (patch 0009): one log line with the details of a draw while
+// the draw list is being logged - the float constants its shaders read and the box its
+// vertices fill - for the city lighting work.
+#define BBRR_PUT(...)                                                              \
+  do {                                                                             \
+    if (at < int(sizeof(line)) - 1) {                                              \
+      int bbrr_n = std::snprintf(line + at, sizeof(line) - size_t(at), __VA_ARGS__); \
+      if (bbrr_n > 0) at = std::min(at + bbrr_n, int(sizeof(line)) - 1);           \
+    }                                                                              \
+  } while (0)
+
+static uint32_t BbrrSwap32(uint32_t v) {
+  return (v >> 24) | ((v >> 8) & 0xFF00u) | ((v << 8) & 0xFF0000u) | (v << 24);
+}
+
+static void BbrrLogDrawDetail(const RegisterFile& regs, const memory::Memory& memory,
+                              const Shader& vertex_shader, const Shader* pixel_shader, bool indexed,
+                              uint32_t index_base, bool index_32bit, xenos::Endian index_endian,
+                              uint32_t index_count) {
+  char line[1536];
+  int at = 0;
+  BBRR_PUT("vs %016llX ps %016llX n %u", static_cast<unsigned long long>(vertex_shader.ucode_data_hash()),
+           static_cast<unsigned long long>(pixel_shader ? pixel_shader->ucode_data_hash() : 0), index_count);
+
+  // Float constants: every one the pixel shader reads (up to 8), the first 6 of the vertex shader.
+  for (int pass = 0; pass < 2; ++pass) {
+    const Shader* shader = pass == 0 ? pixel_shader : &vertex_shader;
+    if (!shader) continue;
+    const uint32_t first_register =
+        pass == 0 ? uint32_t(XE_GPU_REG_SHADER_CONSTANT_256_X) : uint32_t(XE_GPU_REG_SHADER_CONSTANT_000_X);
+    const uint32_t limit = pass == 0 ? 8 : 6;
+    const Shader::ConstantRegisterMap& map = shader->constant_register_map();
+    uint32_t shown = 0;
+    for (uint32_t i = 0; i < 4 && shown < limit; ++i) {
+      uint64_t bits = map.float_bitmap[i];
+      uint32_t bit;
+      while (shown < limit && rex::bit_scan_forward(bits, &bit)) {
+        bits &= ~(1ull << bit);
+        float v[4];
+        std::memcpy(v, &regs[first_register + (i << 8) + (bit << 2)], sizeof(v));
+        BBRR_PUT(" %s%u(%.4g %.4g %.4g %.4g)", pass == 0 ? "pc" : "vc", i * 64 + bit, double(v[0]),
+                 double(v[1]), double(v[2]), double(v[3]));
+        ++shown;
+      }
+    }
+  }
+
+  // Where the vertices are: the first three-float attribute is taken as the position.
+  const Shader::VertexBinding* binding = nullptr;
+  int32_t position_offset = 0;
+  for (const Shader::VertexBinding& b : vertex_shader.vertex_bindings()) {
+    for (const Shader::VertexBinding::Attribute& a : b.attributes) {
+      if (a.fetch_instr.attributes.data_format == xenos::VertexFormat::k_32_32_32_FLOAT) {
+        binding = &b;
+        position_offset = a.fetch_instr.attributes.offset * 4;
+        break;
+      }
+    }
+    if (binding) break;
+  }
+  if (binding && binding->stride_words && position_offset >= 0) {
+    const xenos::xe_gpu_vertex_fetch_t fetch = regs.GetVertexFetch(binding->fetch_constant);
+    const uint32_t address = uint32_t(fetch.address) << 2;
+    const uint32_t size = uint32_t(fetch.size) << 2;
+    const uint32_t stride = binding->stride_words * 4;
+    const bool swap = fetch.endian == xenos::Endian::k8in32;
+    const uint8_t* vertices = memory.TranslatePhysical<const uint8_t*>(address);
+    const uint8_t* indices = indexed ? memory.TranslatePhysical<const uint8_t*>(index_base) : nullptr;
+    const uint32_t index_offset = regs.Get<reg::VGT_INDX_OFFSET>().indx_offset;
+    float lo[3] = {0, 0, 0}, hi[3] = {0, 0, 0};
+    uint32_t used = 0;
+    const uint32_t count = std::min(index_count, uint32_t(4096));
+    if (vertices && (fetch.endian == xenos::Endian::k8in32 || fetch.endian == xenos::Endian::kNone)) {
+      for (uint32_t i = 0; i < count; ++i) {
+        uint32_t index = i;
+        if (indices) {
+          if (index_32bit) {
+            uint32_t raw;
+            std::memcpy(&raw, indices + size_t(i) * 4, 4);
+            index = index_endian == xenos::Endian::k8in32 ? BbrrSwap32(raw) : raw;
+          } else {
+            uint16_t raw;
+            std::memcpy(&raw, indices + size_t(i) * 2, 2);
+            index = index_endian == xenos::Endian::k8in16 ? uint32_t(uint16_t((raw >> 8) | (raw << 8))) : raw;
+          }
+        }
+        index = (index + index_offset) & 0xFFFFFFu;
+        const uint64_t offset = uint64_t(index) * stride + uint32_t(position_offset);
+        if (offset + 12 > size) continue;
+        float p[3];
+        bool finite = true;
+        for (int k = 0; k < 3; ++k) {
+          uint32_t raw;
+          std::memcpy(&raw, vertices + offset + size_t(k) * 4, 4);
+          if (swap) raw = BbrrSwap32(raw);
+          std::memcpy(&p[k], &raw, 4);
+          finite = finite && std::isfinite(p[k]);
+        }
+        if (!finite) continue;
+        for (int k = 0; k < 3; ++k) {
+          lo[k] = used ? std::min(lo[k], p[k]) : p[k];
+          hi[k] = used ? std::max(hi[k], p[k]) : p[k];
+        }
+        ++used;
+      }
+    }
+    BBRR_PUT(" vb %08X stride %u pos+%d end %u idx %s+%u used %u box (%.2f %.2f %.2f)-(%.2f %.2f %.2f)", address,
+             stride, position_offset, uint32_t(fetch.endian), indexed ? (index_32bit ? "32" : "16") : "none",
+             index_offset, used, double(lo[0]), double(lo[1]), double(lo[2]), double(hi[0]), double(hi[1]),
+             double(hi[2]));
+  } else {
+    BBRR_PUT(" no float3 position");
+  }
+  REXLOG_INFO("[bbrr] draw detail {}", line);
+}
+#undef BBRR_PUT
