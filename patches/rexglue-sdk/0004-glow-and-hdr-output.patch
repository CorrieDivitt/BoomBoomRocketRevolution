 namespace rex::ui::d3d12 {
 
+// ---------------------------------------------------------------------------------------
+// Glow and HDR output.
+//
+// When the glow is on or the swap chain is HDR, the last paint step (picture -> back
+// buffer) is done by our own pixel shader instead of the stock one. It reads the
+// picture (gamma-encoded SDR), adds the bloom texture, and writes either SDR again or
+// linear scRGB with the top of the range opened up into the display's HDR headroom.
+//
+// The bloom texture is made each frame at a quarter of the picture's size: bright parts
+// are picked out (the HUD, known from a mask the game supplies, is left out), then
+// blurred three times, wider each time.
+//
+// The shaders are compiled when the presenter starts (d3dcompiler_47.dll); if anything
+// fails, the stock output path is used.
+namespace {
+constexpr DXGI_FORMAT kBloomFormat = DXGI_FORMAT_R16G16B16A16_FLOAT;
+constexpr uint32_t kMaskWidth = 256, kMaskHeight = 144;
+// Slots in our shader-visible descriptor heap.
+constexpr uint32_t kViewBloomA = 0;  // bloomA and the mask must follow each other (t1, t2)
+constexpr uint32_t kViewMask = 1;
+constexpr uint32_t kViewBloomB = 2;
+constexpr uint32_t kViewSourceRing = 3;  // views of the frame's own textures, made per use
+constexpr uint32_t kViewSourceRingSize = 16;
+constexpr uint32_t kViewCount = kViewSourceRing + kViewSourceRingSize;
+constexpr uint32_t kMaskUploadCount = 4;
+// Root parameters: the first three are laid out like the stock ones.
+constexpr UINT kGlowRootSource = 0;     // t0
+constexpr UINT kGlowRootRectangle = 1;  // vertex shader constants
+constexpr UINT kGlowRootConstants = 2;  // pixel shader constants (GlowConstants)
+constexpr UINT kGlowRootExtra = 3;      // t1 (bloom), t2 (mask)
+
+struct GlowConstants {
+  int32_t output_offset[2];
+  float output_size_inv[2];
+  float glow;
+  float linear_out;
+  float paper_white;
+  float headroom;
+  float step[2];
+  float padding[2];
+};
+
+Microsoft::WRL::ComPtr<ID3D12RootSignature> g_glow_root_signature;
+Microsoft::WRL::ComPtr<ID3D12PipelineState> g_bright_pipeline;
+Microsoft::WRL::ComPtr<ID3D12PipelineState> g_blur_pipeline;
+Microsoft::WRL::ComPtr<ID3D12PipelineState> g_final_sdr_pipeline;
+Microsoft::WRL::ComPtr<ID3D12PipelineState> g_final_hdr_pipeline;
+bool g_swap_chain_is_scrgb = false;  // format of the current swap chain
+bool g_display_hdr = false;          // the display the window is on is in HDR mode
+float g_display_peak_nits = 1000.0f;
+
+struct GlowResources {
+  Microsoft::WRL::ComPtr<ID3D12DescriptorHeap> view_heap;
+  Microsoft::WRL::ComPtr<ID3D12DescriptorHeap> rtv_heap;
+  Microsoft::WRL::ComPtr<ID3D12Resource> bloom[2];
+  uint32_t bloom_width = 0, bloom_height = 0;
+  Microsoft::WRL::ComPtr<ID3D12Resource> mask;
+  Microsoft::WRL::ComPtr<ID3D12Resource> mask_upload[kMaskUploadCount];
+  uint32_t mask_upload_next = 0;
+  uint64_t mask_version = 0;
+  uint32_t source_ring_next = 0;
+  // Replaced textures stay alive for a few frames in case the GPU is still using them.
+  std::vector<std::pair<uint64_t, Microsoft::WRL::ComPtr<ID3D12Resource>>> retired;
+  uint64_t frame = 0;
+  bool failed = false;
+} g_glow;
+
+std::mutex g_mask_mutex;
+std::vector<uint8_t> g_mask_cells(size_t(kMaskWidth) * kMaskHeight, 0);
+uint64_t g_mask_version = 1;
+
+const char kGlowShaderCommon[] = R"hlsl(
+cbuffer push_consts_xe : register(b0) {
+  int2 xe_output_offset;
+  float2 xe_output_size_inv;
+  float xe_glow;         // strength, 0 = none
+  float xe_linear_out;   // 0 = gamma-encoded SDR out, 1 = linear scRGB out
+  float xe_paper_white;  // scRGB value of ordinary white (nits / 80)
+  float xe_headroom;     // peak / paper white, >= 1
+  float2 xe_step;        // bright pass: one source texel; blur: distance between taps
+  float2 xe_padding;
+};
+Texture2D<float4> xe_source : register(t0);
+SamplerState xe_sampler : register(s0);
+float3 ToLinear(float3 c) { return pow(max(c, 0.0), 2.2); }
+)hlsl";
+
+// Picture -> quarter size, bright parts only, HUD left out.
+const char kGlowShaderBright[] = R"hlsl(
+Texture2D<float4> xe_mask : register(t2);
+float3 Bright(float2 uv) {
+  float3 c = ToLinear(xe_source.SampleLevel(xe_sampler, uv, 0.0).rgb);
+  return c * smoothstep(0.2, 0.8, max(c.r, max(c.g, c.b)));
+}
+float4 main(float4 position : SV_Position) : SV_Target {
+  float2 uv = position.xy * xe_output_size_inv;
+  float3 sum = Bright(uv + xe_step * float2(-1.0, -1.0)) + Bright(uv + xe_step * float2(1.0, -1.0)) +
+               Bright(uv + xe_step * float2(-1.0, 1.0)) + Bright(uv + xe_step * float2(1.0, 1.0));
+  float hud = xe_mask.SampleLevel(xe_sampler, uv, 0.0).r;
+  return float4(sum * 0.25 * (1.0 - hud), 1.0);
+}
+)hlsl";
+
+// One direction of a 9-texel Gaussian blur (five taps, using linear filtering).
+const char kGlowShaderBlur[] = R"hlsl(
+float4 main(float4 position : SV_Position) : SV_Target {
+  float2 uv = position.xy * xe_output_size_inv;
+  float3 c = xe_source.SampleLevel(xe_sampler, uv, 0.0).rgb * 0.2270270270;
+  c += (xe_source.SampleLevel(xe_sampler, uv + xe_step * 1.3846153846, 0.0).rgb +
+        xe_source.SampleLevel(xe_sampler, uv - xe_step * 1.3846153846, 0.0).rgb) * 0.3162162162;
+  c += (xe_source.SampleLevel(xe_sampler, uv + xe_step * 3.2307692308, 0.0).rgb +
+        xe_source.SampleLevel(xe_sampler, uv - xe_step * 3.2307692308, 0.0).rgb) * 0.0702702703;
+  return float4(c, 1.0);
+}
+)hlsl";
+
+// Picture + bloom -> back buffer (SDR or scRGB).
+const char kGlowShaderFinal[] = R"hlsl(
+Texture2D<float4> xe_bloom : register(t1);
+float4 main(float4 position : SV_Position) : SV_Target {
+  float2 uv = (position.xy - float2(xe_output_offset)) * xe_output_size_inv;
+  float3 color = ToLinear(xe_source.SampleLevel(xe_sampler, uv, 0.0).rgb);
+  if (xe_glow > 0.0) {
+    color += xe_glow * xe_bloom.SampleLevel(xe_sampler, uv, 0.0).rgb;
+  }
+  float brightest = max(color.r, max(color.g, color.b));
+  float darkest = min(color.r, min(color.g, color.b));
+  float level = brightest;
+  if (xe_headroom > 1.0) {
+    // HDR: the upper half of the range grows into the headroom. Strong colours (fireworks)
+    // get all of it, near-white (menu text) only part, so menus do not glare.
+    float saturation = (brightest - darkest) / max(brightest, 1e-5);
+    float share = lerp(0.35, 1.0, saturation);
+    float ramp = smoothstep(0.5, 1.0, saturate(brightest));
+    level *= 1.0 + (xe_headroom - 1.0) * ramp * share;
+  }
+  // Soft shoulder into the limit instead of a hard cut.
+  float limit = max(xe_headroom, 1.0);
+  float knee = 0.8 * limit;
+  if (level > knee) {
+    level = knee + (limit - knee) * tanh((level - knee) / (limit - knee));
+  }
+  color *= level / max(brightest, 1e-5);
+  if (xe_linear_out > 0.5) {
+    return float4(color * xe_paper_white, 1.0);
+  }
+  return float4(pow(saturate(color), 1.0 / 2.2), 1.0);
+}
+)hlsl";
+
+// Compiles the common part plus `body`. Null on failure (logged).
+Microsoft::WRL::ComPtr<ID3DBlob> CompileGlowShader(const char* name, const char* body) {
+  Microsoft::WRL::ComPtr<ID3DBlob> code;
+  static HMODULE compiler = LoadLibraryW(L"d3dcompiler_47.dll");
+  if (!compiler) {
+    REXLOG_WARN("D3D12Presenter: d3dcompiler_47.dll not found - glow and HDR output are off");
+    return code;
+  }
+  using CompileFn = HRESULT(WINAPI*)(LPCVOID, SIZE_T, LPCSTR, const D3D_SHADER_MACRO*, ID3DInclude*,
+                                     LPCSTR, LPCSTR, UINT, UINT, ID3DBlob**, ID3DBlob**);
+  auto compile = reinterpret_cast<CompileFn>(GetProcAddress(compiler, "D3DCompile"));
+  if (!compile) {
+    REXLOG_WARN("D3D12Presenter: D3DCompile not available - glow and HDR output are off");
+    return code;
+  }
+  std::string source = std::string(kGlowShaderCommon) + body;
+  Microsoft::WRL::ComPtr<ID3DBlob> errors;
+  const UINT kOptimizationLevel3 = 1u << 15;  // D3DCOMPILE_OPTIMIZATION_LEVEL3
+  HRESULT result = compile(source.data(), source.size(), name, nullptr, nullptr, "main", "ps_5_1",
+                           kOptimizationLevel3, 0, &code, &errors);
+  if (FAILED(result) || !code) {
+    REXLOG_WARN("D3D12Presenter: glow / HDR shader '{}' did not compile: {}", name,
+                errors ? static_cast<const char*>(errors->GetBufferPointer()) : "(no message)");
+    code.Reset();
+  }
+  return code;
+}
+
+// Tells DXGI what the swap chain holds and looks at the display the window is on.
+void UpdateSwapChainColorSpace(IDXGISwapChain3* swap_chain) {
+  g_display_hdr = false;
+  if (!g_swap_chain_is_scrgb) {
+    swap_chain->SetColorSpace1(DXGI_COLOR_SPACE_RGB_FULL_G22_NONE_P709);
+    return;
+  }
+  if (FAILED(swap_chain->SetColorSpace1(DXGI_COLOR_SPACE_RGB_FULL_G10_NONE_P709))) {
+    REXLOG_WARN("D3D12Presenter: could not set the scRGB colour space on the swap chain");
+  }
+  Microsoft::WRL::ComPtr<IDXGIOutput> output;
+  Microsoft::WRL::ComPtr<IDXGIOutput6> output_6;
+  DXGI_OUTPUT_DESC1 output_desc;
+  if (SUCCEEDED(swap_chain->GetContainingOutput(&output)) && output &&
+      SUCCEEDED(output.As(&output_6)) && SUCCEEDED(output_6->GetDesc1(&output_desc))) {
+    g_display_hdr = output_desc.ColorSpace == DXGI_COLOR_SPACE_RGB_FULL_G2084_NONE_P2020;
+    if (output_desc.MaxLuminance >= 100.0f) {
+      g_display_peak_nits = output_desc.MaxLuminance;
+    }
+  }
+  REXLOG_INFO("D3D12Presenter: HDR output on; display HDR is {}, peak {:.0f} nits",
+              g_display_hdr ? "on" : "off (showing SDR)", g_display_peak_nits);
+}
+
+// Makes the heaps, the mask texture and bloom textures of the size needed. False if the
+// glow path cannot be used.
+bool EnsureGlowResources(ID3D12Device* device, uint32_t picture_width, uint32_t picture_height) {
+  if (g_glow.failed) return false;
+  ++g_glow.frame;
+  while (!g_glow.retired.empty() && g_glow.retired.front().first + 16 < g_glow.frame) {
+    g_glow.retired.erase(g_glow.retired.begin());
+  }
+  auto fail = [](const char* what) {
+    REXLOG_WARN("D3D12Presenter: glow resources: could not create {} - glow / HDR output is off", what);
+    g_glow.failed = true;
+    return false;
+  };
+  if (!g_glow.view_heap) {
+    D3D12_DESCRIPTOR_HEAP_DESC view_heap_desc = {};
+    view_heap_desc.Type = D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV;
+    view_heap_desc.NumDescriptors = kViewCount;
+    view_heap_desc.Flags = D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE;
+    if (FAILED(device->CreateDescriptorHeap(&view_heap_desc, IID_PPV_ARGS(&g_glow.view_heap)))) {
+      return fail("the view heap");
+    }
+    D3D12_DESCRIPTOR_HEAP_DESC rtv_heap_desc = {};
+    rtv_heap_desc.Type = D3D12_DESCRIPTOR_HEAP_TYPE_RTV;
+    rtv_heap_desc.NumDescriptors = 2;
+    if (FAILED(device->CreateDescriptorHeap(&rtv_heap_desc, IID_PPV_ARGS(&g_glow.rtv_heap)))) {
+      return fail("the render target heap");
+    }
+  }
+  const UINT view_size = device->GetDescriptorHandleIncrementSize(D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+  const UINT rtv_size = device->GetDescriptorHandleIncrementSize(D3D12_DESCRIPTOR_HEAP_TYPE_RTV);
+  const D3D12_CPU_DESCRIPTOR_HANDLE view_start = g_glow.view_heap->GetCPUDescriptorHandleForHeapStart();
+  const D3D12_CPU_DESCRIPTOR_HANDLE rtv_start = g_glow.rtv_heap->GetCPUDescriptorHandleForHeapStart();
+  auto view_at = [&](uint32_t slot) {
+    D3D12_CPU_DESCRIPTOR_HANDLE handle = view_start;
+    handle.ptr += SIZE_T(slot) * view_size;
+    return handle;
+  };
+  D3D12_SHADER_RESOURCE_VIEW_DESC srv_desc = {};
+  srv_desc.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+  srv_desc.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+  srv_desc.Texture2D.MipLevels = 1;
+
+  if (!g_glow.mask) {
+    D3D12_RESOURCE_DESC mask_desc = {};
+    mask_desc.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    mask_desc.Width = kMaskWidth;
+    mask_desc.Height = kMaskHeight;
+    mask_desc.DepthOrArraySize = 1;
+    mask_desc.MipLevels = 1;
+    mask_desc.Format = DXGI_FORMAT_R8_UNORM;
+    mask_desc.SampleDesc.Count = 1;
+    if (FAILED(device->CreateCommittedResource(&util::kHeapPropertiesDefault, D3D12_HEAP_FLAG_NONE,
+                                               &mask_desc, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE,
+                                               nullptr, IID_PPV_ARGS(&g_glow.mask)))) {
+      return fail("the HUD mask");
+    }
+    srv_desc.Format = DXGI_FORMAT_R8_UNORM;
+    device->CreateShaderResourceView(g_glow.mask.Get(), &srv_desc, view_at(kViewMask));
+    D3D12_RESOURCE_DESC upload_desc = {};
+    upload_desc.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+    upload_desc.Width = UINT64(kMaskWidth) * kMaskHeight;  // row pitch 256 = the width
+    upload_desc.Height = 1;
+    upload_desc.DepthOrArraySize = 1;
+    upload_desc.MipLevels = 1;
+    upload_desc.SampleDesc.Count = 1;
+    upload_desc.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    for (Microsoft::WRL::ComPtr<ID3D12Resource>& upload : g_glow.mask_upload) {
+      if (FAILED(device->CreateCommittedResource(&util::kHeapPropertiesUpload, D3D12_HEAP_FLAG_NONE,
+                                                 &upload_desc, D3D12_RESOURCE_STATE_GENERIC_READ,
+                                                 nullptr, IID_PPV_ARGS(&upload)))) {
+        return fail("a mask upload buffer");
+      }
+    }
+    g_glow.mask_version = 0;
+  }
+
+  const uint32_t bloom_width = std::max(picture_width / 4, uint32_t(1));
+  const uint32_t bloom_height = std::max(picture_height / 4, uint32_t(1));
+  if (!g_glow.bloom[0] || g_glow.bloom_width != bloom_width || g_glow.bloom_height != bloom_height) {
+    D3D12_RESOURCE_DESC bloom_desc = {};
+    bloom_desc.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    bloom_desc.Width = bloom_width;
+    bloom_desc.Height = bloom_height;
+    bloom_desc.DepthOrArraySize = 1;
+    bloom_desc.MipLevels = 1;
+    bloom_desc.Format = kBloomFormat;
+    bloom_desc.SampleDesc.Count = 1;
+    bloom_desc.Flags = D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET;
+    D3D12_RENDER_TARGET_VIEW_DESC rtv_desc = {};
+    rtv_desc.Format = kBloomFormat;
+    rtv_desc.ViewDimension = D3D12_RTV_DIMENSION_TEXTURE2D;
+    srv_desc.Format = kBloomFormat;
+    for (uint32_t i = 0; i < 2; ++i) {
+      if (g_glow.bloom[i]) g_glow.retired.emplace_back(g_glow.frame, g_glow.bloom[i]);
+      g_glow.bloom[i].Reset();
+      if (FAILED(device->CreateCommittedResource(&util::kHeapPropertiesDefault, D3D12_HEAP_FLAG_NONE,
+                                                 &bloom_desc, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE,
+                                                 nullptr, IID_PPV_ARGS(&g_glow.bloom[i])))) {
+        return fail("a bloom texture");
+      }
+      device->CreateShaderResourceView(g_glow.bloom[i].Get(), &srv_desc,
