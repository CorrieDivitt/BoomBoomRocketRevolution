+void SetOutputGlowMask(const uint8_t* cells, uint32_t width, uint32_t height) {
+  if (!cells || width != kMaskWidth || height != kMaskHeight) return;
+  std::lock_guard<std::mutex> lock(g_mask_mutex);
+  if (std::memcmp(g_mask_cells.data(), cells, g_mask_cells.size()) == 0) return;
+  std::memcpy(g_mask_cells.data(), cells, g_mask_cells.size());
+  ++g_mask_version;
+}
