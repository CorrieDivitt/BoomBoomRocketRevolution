+// A view of `texture` (10-bit picture format) in our heap, for use in this frame.
+D3D12_GPU_DESCRIPTOR_HANDLE MakeSourceView(ID3D12Device* device, ID3D12Resource* texture) {
+  const UINT view_size = device->GetDescriptorHandleIncrementSize(D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+  const uint32_t slot = kViewSourceRing + (g_glow.source_ring_next++ % kViewSourceRingSize);
+  D3D12_SHADER_RESOURCE_VIEW_DESC srv_desc = {};
+  srv_desc.Format = DXGI_FORMAT_R10G10B10A2_UNORM;
+  srv_desc.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+  srv_desc.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+  srv_desc.Texture2D.MipLevels = 1;
+  D3D12_CPU_DESCRIPTOR_HANDLE cpu = g_glow.view_heap->GetCPUDescriptorHandleForHeapStart();
+  cpu.ptr += SIZE_T(slot) * view_size;
+  device->CreateShaderResourceView(texture, &srv_desc, cpu);
+  D3D12_GPU_DESCRIPTOR_HANDLE gpu = g_glow.view_heap->GetGPUDescriptorHandleForHeapStart();
+  gpu.ptr += UINT64(slot) * view_size;
+  return gpu;
+}
+
+D3D12_GPU_DESCRIPTOR_HANDLE GlowView(ID3D12Device* device, uint32_t slot) {
+  D3D12_GPU_DESCRIPTOR_HANDLE gpu = g_glow.view_heap->GetGPUDescriptorHandleForHeapStart();
+  gpu.ptr += UINT64(slot) * device->GetDescriptorHandleIncrementSize(D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+  return gpu;
+}
