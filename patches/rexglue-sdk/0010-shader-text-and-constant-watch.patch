+// Patch 0010: log the lighting constants of one pixel shader whenever they change (the
+// position in c15 / c19 moves all the time, so only its fourth value counts as a change).
+static void BbrrWatchConstants(const RegisterFile& regs, uint64_t pixel_hash) {
+  static const uint32_t kWatched[] = {1, 5, 7, 11, 12, 15, 19};
+  static float last[rex::countof(kWatched)][4];
+  static uint32_t lines = 0;
+  static uint64_t draws = 0;
+  ++draws;
+  if (lines >= 800) return;
+  float now[rex::countof(kWatched)][4];
+  bool changed = false;
+  for (size_t i = 0; i < rex::countof(kWatched); ++i) {
+    std::memcpy(now[i], &regs[XE_GPU_REG_SHADER_CONSTANT_256_X + (kWatched[i] << 2)], sizeof(now[i]));
+    const bool position = kWatched[i] == 15 || kWatched[i] == 19;
+    for (int k = position ? 3 : 0; k < 4; ++k) {
+      if (std::memcmp(&now[i][k], &last[i][k], sizeof(float)) != 0) changed = true;
+    }
+  }
+  if (!changed) return;
+  std::memcpy(last, now, sizeof(last));
+  ++lines;
+  char line[768];
+  int at = 0;
+  for (size_t i = 0; i < rex::countof(kWatched); ++i) {
+    int n = std::snprintf(line + at, sizeof(line) - size_t(at), " c%u(%.4g %.4g %.4g %.4g)", kWatched[i],
+                          double(now[i][0]), double(now[i][1]), double(now[i][2]), double(now[i][3]));
+    if (n > 0) at = std::min(at + n, int(sizeof(line)) - 1);
+  }
+  REXLOG_INFO("[bbrr] watch {:016X} draw {}:{}", pixel_hash, draws, line);
 }
