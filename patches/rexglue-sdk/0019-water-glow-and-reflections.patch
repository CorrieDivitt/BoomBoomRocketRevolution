+// ---------------------------------------------------------------------------------------
+// Boom Boom Rocket Revolution (patch 0019): fireworks and the water.
+//
+// The water (pixel shader FB9F...) mixes a mirror picture of the scene with one specular
+// highlight: light position c2 (the moon), shininess c3, colour c4. Water Glow moves that
+// highlight to the fireworks of this frame and gives it their colour, so bursts glint in the
+// water where their reflection would be.
+//
+// Water Reflections draws the firework bursts (vertex shader BA59..., drawn after the
+// water) a second time with the mirror camera of this frame (the city's mirror pass,
+// vertex shader C837..., constants c0-c3), so they appear where the water reflects them.
+// Whether the water writes depth decides whether the copy shows; the first frame logs the
+// depth state of both draws.
+constexpr uint64_t kBbrrWaterPixelShader = 0xFB9F9B10B8537018ull;
+constexpr uint64_t kBbrrMirrorCityVertexShader = 0xC837C4CC9C032EC1ull;
+constexpr uint64_t kBbrrBurstVertexShader = 0xBA59DDB09CB51DE2ull;
+uint32_t bbrr_mirror[16];
+uint64_t bbrr_mirror_frame = ~uint64_t(0);
+bool bbrr_redrawing = false;
+
+bool BbrrLightWater(RegisterFile& regs, float glow, BbrrConstantGuard& guard) {
+  const BbrrFrameLight& f = bbrr_frame_light;
+  if (f.frame != bbrr_frame || !f.valid) return false;
+  const float brightest = std::max(f.total[0], std::max(f.total[1], f.total[2]));
+  if (!(brightest > 0.02f)) return false;
+  const uint32_t pixel_base = XE_GPU_REG_SHADER_CONSTANT_256_X;
+  float colour[4];
+  BbrrReadFloats(regs, pixel_base, 4, colour);
+  for (int k = 0; k < 3; ++k) {
+    guard.Set(&regs[pixel_base + (2 << 2) + uint32_t(k)], f.centre[k]);
+    guard.Set(&regs[pixel_base + (4 << 2) + uint32_t(k)],
+              std::min(colour[k] + f.total[k] * 0.8f * glow, 4.0f));
+  }
+  guard.Set(&regs[pixel_base + (3 << 2)], 20.0f);  // a broader highlight than the moon's (50)
+  return true;
+}
