+xam::UserProfile* KernelState::user_profile(uint32_t user_index) const {
+  if (user_index == 0) return user_profile_.get();
+  if (user_index < 4) return other_user_profiles_[user_index - 1].get();
+  return nullptr;
+}
+
+uint32_t KernelState::signed_in_mask() const {
+  uint32_t mask = 0;
+  for (uint32_t i = 0; i < 4; ++i) {
+    if (user_profile(i)) mask |= 1u << i;
+  }
+  return mask;
+}
+
+void KernelState::SignInUser(uint32_t user_index, uint64_t xuid, const std::string& name) {
+  if (user_index >= 4) return;
+  auto profile = std::make_unique<xam::UserProfile>();
+  profile->set_kernel_state(this);
+  profile->set_identity(xuid, name);
+  {
+    std::lock_guard lock(user_profiles_mutex_);
+    auto& slot = user_index == 0 ? user_profile_ : other_user_profiles_[user_index - 1];
+    if (slot) retired_user_profiles_.push_back(std::move(slot));
+    slot = std::move(profile);
+  }
+  REXSYS_INFO("Signed in {} ({:016X}) as user {}", name, xuid, user_index);
+  if (user_index == 0 && title_id() != 0 && !emulator_->user_data_root().empty()) {
+    achievement_manager_.SetUnlockSavePath(AchievementSavePath(xuid));
+    achievement_manager_.LoadUnlockState();
+  }
+}
+
+void KernelState::SignOutUser(uint32_t user_index) {
+  if (user_index == 0 || user_index >= 4) return;
+  std::lock_guard lock(user_profiles_mutex_);
+  auto& slot = other_user_profiles_[user_index - 1];
+  if (slot) {
+    REXSYS_INFO("Signed out user {}", user_index);
+    retired_user_profiles_.push_back(std::move(slot));
+  }
+}
+
+std::filesystem::path KernelState::AchievementSavePath(uint64_t xuid) const {
+  const auto user_root = emulator_->user_data_root();
+  const auto title = fmt::format("{:08X}.toml", title_id());
+  const auto path = user_root / "achievements" / fmt::format("{:016X}", xuid) / title;
+  // Unlocks from before profiles had their own file belong to the original profile.
+  constexpr uint64_t kOriginalXuid = 0xB13EBABEBABEBABEull;
+  std::error_code ec;
+  if (xuid == kOriginalXuid && !std::filesystem::exists(path, ec)) {
+    const auto old_path = user_root / "achievements" / title;
+    if (std::filesystem::exists(old_path, ec)) {
+      std::filesystem::create_directories(path.parent_path(), ec);
+      std::filesystem::copy_file(old_path, path, ec);
+    }
+  }
+  return path;
+}
+
+void KernelState::UnlockAchievementForUser(uint32_t user_index, uint32_t id) {
+  if (user_index == 0 || user_index >= 4) {
+    UnlockAchievement(id);
+    return;
+  }
+  auto* profile = user_profile(user_index);
+  if (!profile || emulator_->user_data_root().empty()) return;
+  AchievementManager other;
+  other.ReplaceAchievements(achievement_manager_.ListAchievements());
+  other.SetUnlockSavePath(AchievementSavePath(profile->xuid()));
+  other.LoadUnlockState();
+  if (other.UnlockAchievement(id) == AchievementUnlockResult::kUnlocked) {
+    other.SaveUnlockState();
+    REXSYS_INFO("Achievement {} unlocked for {} (user {})", id, profile->name(), user_index);
+  }
+}
