+// Pixel shader for those: the overlay's sRGB colours made linear and scaled to the game's
+// white, so menus are not dim and washed out in HDR. Compiled at start; if it cannot be,
+// the HDR pipelines keep the ordinary pixel shader.
+constexpr char kHdrPixelShader[] = R"hlsl(
+Texture2D xe_immediate_texture : register(t0);
+SamplerState xe_immediate_sampler : register(s0);
+cbuffer xe_ui_constants : register(b1) { float xe_ui_white; };
+float4 main(float2 uv : TEXCOORD0, float4 colour : COLOR0) : SV_Target {
+  float4 result = xe_immediate_texture.SampleLevel(xe_immediate_sampler, uv, 0.0) * colour;
+  result.rgb = pow(max(result.rgb, 0.0), 2.2) * xe_ui_white;
+  return result;
+}
+)hlsl";
