+// XShowAchievementsUI: the title's own "Achievements" menu entry. Shows the list the F7
+// overlay shows (icons, gamerscore, locked/unlocked), as a XAM dialog: the title is told the
+// system UI is up (XN_SYS_UI) and its input is held while it is open. Driven by the
+// controller as well as the keyboard: B, Back or A closes it, d-pad / left stick scroll.
+class AchievementsUIDialog : public XamDialog {
+ public:
+  // user_index: whose achievements (the player who opened the menu). Player 1's are the live
+  // ones; another player's are read from that profile's own unlock file.
+  AchievementsUIDialog(rex::ui::ImGuiDrawer* imgui_drawer, rex::Runtime* runtime, uint32_t user_index)
+      : XamDialog(imgui_drawer), icons_(imgui_drawer->immediate_drawer(), runtime) {
+    auto* ks = REX_KERNEL_STATE();
+    if (const auto* profile = user_index < 4 ? ks->user_profile(user_index) : nullptr) {
+      owner_ = profile->name();
+      if (user_index != 0) {
+        other_ = std::make_unique<rex::system::AchievementManager>();
+        other_->ReplaceAchievements(ks->achievements().ListAchievements());
+        other_->SetUnlockSavePath(ks->AchievementSavePath(profile->xuid()));
+        other_->LoadUnlockState();
+      }
+    }
+  }
+
+  void OnDraw(ImGuiIO& io) override {
+    // Controller, read past the hold on guest input.
+    uint16_t buttons = 0;
+    float stick = 0.0f;
+    auto* runtime = REX_KERNEL_STATE()->emulator();
+    if (auto* input = runtime ? static_cast<rex::input::InputSystem*>(runtime->input_system()) : nullptr) {
+      for (uint32_t user = 0; user < 4; ++user) {
+        rex::input::X_INPUT_STATE state = {};
+        if (input->GetStateForUI(user, &state) != X_ERROR_SUCCESS) continue;
+        buttons |= static_cast<uint16_t>(state.gamepad.buttons);
+        const float ly = static_cast<int16_t>(state.gamepad.thumb_ly) / 32767.0f;
+        if (std::fabs(ly) > std::fabs(stick)) stick = ly;
+      }
+    }
+    // Buttons already down when the list opened (the A that chose the menu entry) count only
+    // once they have been let go.
+    if (first_draw_) held_ = buttons;
+    held_ &= buttons;
+    const uint16_t pressed = static_cast<uint16_t>(buttons & ~held_ & ~last_buttons_);
+    last_buttons_ = buttons;
+    const bool close = (pressed & (0x2000 | 0x1000 | 0x0020)) != 0 ||  // B, A, Back
+                       ImGui::IsKeyPressed(ImGuiKey_Escape) || ImGui::IsKeyPressed(ImGuiKey_Enter);
+    float scroll = 0.0f;
+    if (buttons & 0x0001) scroll -= 1.0f;  // d-pad up
+    if (buttons & 0x0002) scroll += 1.0f;  // d-pad down
+    if (std::fabs(stick) > 0.25f) scroll -= stick;
+    first_draw_ = false;
+
+    const rex::ui::AchievementsStyle& style = imgui_drawer()->style().achievements;
+    const ImVec2 size(std::min(720.0f, io.DisplaySize.x * 0.9f), io.DisplaySize.y * 0.8f);
+    ImGui::SetNextWindowPos(ImVec2(io.DisplaySize.x * 0.5f, io.DisplaySize.y * 0.5f), ImGuiCond_Always,
+                            ImVec2(0.5f, 0.5f));
+    ImGui::SetNextWindowSize(size, ImGuiCond_Always);
+    ImGui::SetNextWindowFocus();
+    // Opaque, over a darkened screen: the game's menu behind it must not show through.
+    ImGui::GetBackgroundDrawList()->AddRectFilled(ImVec2(0.0f, 0.0f), io.DisplaySize, IM_COL32(0, 0, 0, 190));
+    ImGui::PushStyleVar(ImGuiStyleVar_Alpha, 1.0f);
+    ImGui::PushStyleVar(ImGuiStyleVar_WindowPadding, style.window_padding);
+    ImGui::PushStyleVar(ImGuiStyleVar_ItemSpacing, style.item_spacing);
+    ImGui::PushStyleColor(ImGuiCol_WindowBg, ImVec4(0.03f, 0.05f, 0.04f, 1.0f));
+    ImGui::PushStyleColor(ImGuiCol_ChildBg, ImVec4(0.03f, 0.05f, 0.04f, 1.0f));
+    if (ImGui::Begin("Achievements##xamui", nullptr,
+                     ImGuiWindowFlags_NoCollapse | ImGuiWindowFlags_NoResize | ImGuiWindowFlags_NoMove |
+                         ImGuiWindowFlags_NoSavedSettings)) {
+      const auto& manager = other_ ? *other_ : REX_KERNEL_STATE()->achievements();
+      const auto achievements = manager.ListAchievements();
+      if (!owner_.empty()) {
+        ImGui::PushStyleColor(ImGuiCol_Text, style.header_text);
+        ImGui::Text("%s", owner_.c_str());
+        ImGui::PopStyleColor();
+      }
+      int unlocked = 0, total_gs = 0, earned_gs = 0;
+      for (const auto& a : achievements) {
+        total_gs += static_cast<int>(a.gamerscore);
+        if (manager.IsUnlocked(a.id)) ++unlocked, earned_gs += static_cast<int>(a.gamerscore);
+      }
+      ImGui::PushStyleColor(ImGuiCol_Text, style.header_text);
+      ImGui::Text("%d / %d unlocked", unlocked, static_cast<int>(achievements.size()));
+      ImGui::PopStyleColor();
+      ImGui::SameLine();
+      ImGui::TextColored(style.badge_gamerscore, "%dG / %dG", earned_gs, total_gs);
+      ImGui::PushStyleColor(ImGuiCol_PlotHistogram, style.progress_bar);
+      ImGui::ProgressBar(achievements.empty() ? 0.0f : float(unlocked) / float(achievements.size()),
+                         ImVec2(-1.0f, 6.0f), "");
+      ImGui::PopStyleColor();
+      ImGui::Separator();
+
+      ImGui::BeginChild("##achlist", ImVec2(0.0f, -ImGui::GetFrameHeightWithSpacing()), false);
+      if (scroll != 0.0f) ImGui::SetScrollY(ImGui::GetScrollY() + scroll * 900.0f * io.DeltaTime);
+      for (const auto& a : achievements) {
+        const bool is_unlocked = manager.IsUnlocked(a.id);
+        ImGui::PushID(static_cast<int>(a.id));
+        if (rex::ui::ImmediateTexture* icon = icons_.GetIcon(a)) {
+          ImGui::ImageWithBg(reinterpret_cast<ImTextureID>(icon), ImVec2(style.icon_size, style.icon_size),
+                             ImVec2(0, 0), ImVec2(1, 1), ImVec4(0, 0, 0, 0),
+                             is_unlocked ? style.unlocked_icon_tint : style.locked_icon_tint);
+        } else {
+          ImGui::Dummy(ImVec2(style.icon_size, style.icon_size));
+        }
+        ImGui::SameLine();
+        ImGui::BeginGroup();
+        const ImVec4& title_color = is_unlocked ? style.unlocked_title : style.locked_title;
+        ImGui::TextColored(title_color, "%s", is_unlocked ? "[*]" : "[ ]");
+        ImGui::SameLine();
+        ImGui::TextColored(style.badge_gamerscore, "%dG", static_cast<int>(a.gamerscore));
+        ImGui::SameLine();
+        ImGui::TextColored(title_color, "%s", a.label.c_str());
+        ImGui::PushStyleColor(ImGuiCol_Text, is_unlocked ? style.unlocked_desc : style.locked_desc);
+        ImGui::TextWrapped("%s", (is_unlocked ? a.description : a.unachieved_description).c_str());
+        ImGui::PopStyleColor();
+        ImGui::EndGroup();
+        ImGui::Separator();
+        ImGui::PopID();
+      }
+      ImGui::EndChild();
+      ImGui::TextDisabled("B / Esc: close      D-pad / left stick: scroll");
+    }
+    ImGui::End();
+    ImGui::PopStyleColor(2);
+    ImGui::PopStyleVar(3);
+    if (close) Close();
+  }
+
+ private:
+  rex::ui::AchievementIconCache icons_;
+  std::unique_ptr<rex::system::AchievementManager> other_;
+  std::string owner_;
+  bool first_draw_ = true;
+  uint16_t held_ = 0, last_buttons_ = 0;
+};
+
+std::atomic<bool> xam_achievements_ui_open_{false};
+
+u32 XamShowAchievementsUI_entry(u32 user_index) {
+  REXKRNL_INFO("XamShowAchievementsUI({})", uint32_t(user_index));
+  Runtime* emulator = REX_KERNEL_STATE()->emulator();
+  ui::ImGuiDrawer* imgui_drawer = emulator ? emulator->imgui_drawer() : nullptr;
+  if (!imgui_drawer || REXCVAR_GET(headless) || xam_achievements_ui_open_.exchange(true)) {
+    return X_ERROR_SUCCESS;
+  }
+  // The real call returns at once and the Guide shows the list on its own; the title learns
+  // of it through XN_SYS_UI. So the dialog runs on a thread of its own, not the title's.
+  const uint32_t user = user_index;
+  std::thread([imgui_drawer, emulator, user]() {
+    auto close = [](AchievementsUIDialog*) -> X_RESULT { return X_ERROR_SUCCESS; };
+    xeXamDispatchDialog<AchievementsUIDialog>(new AchievementsUIDialog(imgui_drawer, emulator, user), close,
+                                              0);
+    xam_achievements_ui_open_.store(false);
+  }).detach();
+  return X_ERROR_SUCCESS;
+}
+
+u32 XamShowAchievementsUIEx_entry(u32 user_index, u32 flags) {
+  (void)flags;
+  return XamShowAchievementsUI_entry(user_index);
+}
