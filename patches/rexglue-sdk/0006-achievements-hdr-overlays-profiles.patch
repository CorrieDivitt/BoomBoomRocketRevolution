+void ShowTextEntryDialog(std::string title, std::string description, std::string default_text,
+                         size_t max_length, std::function<void(bool, std::string)> done) {
+  Runtime* emulator = REX_KERNEL_STATE()->emulator();
+  ui::ImGuiDrawer* imgui_drawer = emulator ? emulator->imgui_drawer() : nullptr;
+  if (!imgui_drawer || REXCVAR_GET(headless)) {
+    if (done) done(false, "");
+    return;
+  }
+  std::thread([imgui_drawer, title, description, default_text, max_length, done]() {
+    bool ok = false;
+    std::string text;
+    auto close = [&ok, &text](KeyboardInputDialog* dialog) -> X_RESULT {
+      ok = !dialog->cancelled();
+      text = std::string(dialog->text().c_str());
+      return X_ERROR_SUCCESS;
+    };
+    xeXamDispatchDialog<KeyboardInputDialog>(
+        new KeyboardInputDialog(imgui_drawer, title, description, default_text, max_length + 1), close, 0);
+    if (done) done(ok, ok ? text : std::string());
+  }).detach();
+}
