+std::string DeviceKey(const std::vector<DeviceInfo>& devices, const DeviceInfo& device) {
+  uint32_t n = 0;
+  for (const auto& other : devices) {
+    if (other.id == device.id) break;
+    if (!other.synthetic && other.guid == device.guid) ++n;
+  }
+  return device.guid + "#" + std::to_string(n);
+}
