+// Patch 0030: the average world position of up to 64 sampled sparks of the current burst draw
+// (same vertex reading as BbrrProbe). Returns false if it cannot be read.
+bool BbrrSparkCentre(const RegisterFile& regs, const memory::Memory& memory, const Shader& vertex_shader,
+                     float centre[3]) {
+  auto init = regs.Get<reg::VGT_DRAW_INITIATOR>();
+  if (!init.num_indices) return false;
+  const Shader::VertexBinding* pos_binding = nullptr;
+  int32_t pos_offset = 0;
+  for (const auto& b : vertex_shader.vertex_bindings()) {
+    for (const auto& a : b.attributes) {
+      const auto& at = a.fetch_instr.attributes;
+      if (at.data_format == xenos::VertexFormat::k_32_32_32_FLOAT &&
+          (!pos_binding || (pos_binding == &b && at.offset < pos_offset))) {
+        pos_binding = &b;
+        pos_offset = at.offset;
+      }
+    }
+  }
+  if (!pos_binding) return false;
+  const xenos::xe_gpu_vertex_fetch_t fetch = regs.GetVertexFetch(pos_binding->fetch_constant);
+  const uint8_t* vertices = memory.TranslatePhysical<const uint8_t*>(fetch.address << 2);
+  const uint32_t stride_bytes = pos_binding->stride_words * 4;
+  const uint32_t buffer_bytes = fetch.size * 4;
+  auto dma_size = regs.Get<reg::VGT_DMA_SIZE>();
+  xenos::Endian index_endian = dma_size.swap_mode;
+  const uint16_t* indices_16 = nullptr;
+  const uint32_t* indices_32 = nullptr;
+  if (init.source_select == xenos::SourceSelect::kDMA) {
+    uint32_t base_address = regs[XE_GPU_REG_VGT_DMA_BASE];
+    if (init.index_size == xenos::IndexFormat::kInt16) {
+      if (index_endian == xenos::Endian::k8in32) index_endian = xenos::Endian::k8in16;
+      else if (index_endian == xenos::Endian::k16in32) index_endian = xenos::Endian::kNone;
+      indices_16 = memory.TranslatePhysical<const uint16_t*>(base_address & ~uint32_t(1));
+    } else {
+      indices_32 = memory.TranslatePhysical<const uint32_t*>(base_address & ~uint32_t(3));
+    }
+  } else if (init.source_select != xenos::SourceSelect::kAutoIndex) {
+    return false;
+  }
+  const uint32_t index_offset = regs.Get<reg::VGT_INDX_OFFSET>().indx_offset;
+  const uint32_t min_index = regs.Get<reg::VGT_MIN_VTX_INDX>().min_indx;
+  const uint32_t max_index = regs.Get<reg::VGT_MAX_VTX_INDX>().max_indx;
+  double sum[3] = {};
+  uint32_t n = 0;
+  const uint32_t count = init.num_indices;
+  const uint32_t step = std::max<uint32_t>(1, count / 64);
+  for (uint32_t i = 0; i < count; i += step) {
+    uint32_t vertex_index = i;
+    if (indices_16 || indices_32) {
+      if (i >= dma_size.num_words) break;
+      vertex_index = indices_16 ? indices_16[i] : indices_32[i];
+      vertex_index = xenos::GpuSwap(vertex_index, index_endian) & 0xFFFFFF;
+    }
+    vertex_index = std::min(max_index, std::max(min_index, (vertex_index + index_offset) & 0xFFFFFF));
+    const uint32_t byte = vertex_index * stride_bytes + uint32_t(pos_offset) * 4;
+    if (byte + 12 > buffer_bytes) continue;
+    for (int k = 0; k < 3; ++k) {
+      uint32_t word;
+      std::memcpy(&word, vertices + byte + k * 4, 4);
+      word = xenos::GpuSwap(word, fetch.endian);
+      float f;
+      std::memcpy(&f, &word, 4);
+      sum[k] += f;
+    }
+    ++n;
+  }
+  if (!n) return false;
+  for (int k = 0; k < 3; ++k) centre[k] = float(sum[k] / n);
+  return true;
+}
