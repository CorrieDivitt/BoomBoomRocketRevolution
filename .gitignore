/out/
/build/
*.pe
*.bin
__pycache__/
.vs/
.vscode/
*.user

# Calibration metronome sounds: beat.wav and subbeat.wav ship with the release (royalty-free);
# any other WAVs in the folder are the user's own.
/calibration_sounds/*.wav
!/calibration_sounds/beat.wav
!/calibration_sounds/subbeat.wav
